{
  "permissions": {
    "allow": [
      "Edit(/checklists/**)",
      "Edit(/plans/**)"
    ],
    "deny": [
      "Bash",
      "PowerShell",
      "WebFetch",
      "WebSearch",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.git-credentials)"
    ]
  }
}
